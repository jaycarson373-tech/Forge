NODE_ENV=production
APP_MODE=live
HOST=0.0.0.0
PORT=8787
PUBLIC_URL=https://YOUR-FORGE-DOMAIN
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://YOUR-PRIVATE-MAINNET-RPC
PLATFORM_FEE_WALLET=YOUR_PUBLIC_SOLANA_FEE_WALLET
# Add after config creation, or register it in the Settings screen.
DBC_CONFIG_ADDRESS=
# Keep false through preflight checks; then explicitly enable wallet-signed transactions.
ENABLE_MAINNET_TRANSACTIONS=false
DATA_PATH=/app/data/forge.sqlite
